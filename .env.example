NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
ADMIN_EMAIL=you@example.com
# Server-only secret (captions + AI suggestions). Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-key
# Optional: write scripts, captions and suggestions with Claude instead of Gemini (server-only; never NEXT_PUBLIC_).
ANTHROPIC_API_KEY=
# AI_PROVIDER=claude
# Reel scripts on Claude: haiku (default), sonnet (recommended, ~$0.07/script) or opus (best writing, ~$0.16/script); effort low|medium|high (default medium).
# AI_SCRIPT_MODEL=haiku
# AI_SCRIPT_EFFORT=medium
# Names PDF shop (/shop, docs/SHOP.md). Server-only; never prefix with NEXT_PUBLIC_. Test keys first, then live.
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
# The secret PayMongo shows when you add the webhook (https://<your site>/api/paymongo/webhook, event checkout_session.payment.paid)
PAYMONGO_WEBHOOK_SECRET=
# Optional: more methods once your PayMongo account allows them (default: qrph = GCash, Maya and bank apps by QR Ph)
# SHOP_PAYMENT_METHODS=qrph,gcash,paymaya
# Your site's https address for payment and email links (default: Vercel's production URL)
# SHOP_BASE_URL=https://your-site.vercel.app
# The page's Messenger link for "Need help?" (overrides the pack's)
# SHOP_MESSENGER_URL=https://m.me/yourpage
# Optional: email the buyer their link + password through Gmail (an app password, not your Gmail password)
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=you@gmail.com
