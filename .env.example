NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
ADMIN_EMAIL=you@example.com
# Server-only secret (captions + AI suggestions). Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-key
# Optional: write scripts, captions and suggestions with Claude instead of Gemini (server-only; never NEXT_PUBLIC_).
ANTHROPIC_API_KEY=
# AI_PROVIDER=claude
# Reel scripts on Claude: haiku (default), sonnet (recommended, ~$0.07/script) or opus (best writing, ~$0.16/script); effort low|medium|high (default medium).
# AI_SCRIPT_MODEL=haiku
# AI_SCRIPT_EFFORT=medium
